# ==========================================
# CyberVerify Environment Configuration
# ==========================================

# MongoDB Database URL
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=cyberverify_db

# External Search API (Optional - automatically falls back to DuckDuckGo search)
TAVILY_API_KEY=

# LLM APIs for Enhanced Analysis (Optional - system includes built-in NLP heuristics)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Security & Limits
REQUEST_TIMEOUT=15
MAX_SEARCH_RESULTS=10
RATE_LIMIT_PER_MINUTE=60
